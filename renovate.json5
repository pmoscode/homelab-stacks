{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Europe/Berlin',
  // No schedule and no limits: open every update PR right away, all at once.
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  // Image tags stay pinned in compose.yaml; every update arrives as a pull request.
  // Merging does not deploy: Resource Sync only redeploys on TOML changes, so deploy the stack in Komodo.
  automerge: false,
  packageRules: [
    {
      description: 'Major updates only after approval in the dependency dashboard (check release notes and migrations first).',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'PostgreSQL major upgrades need a dump and restore, never offer them.',
      matchDatasources: ['docker'],
      matchPackageNames: ['postgres'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      description: 'Own image tagged by branch and commit (main-<sha>), not versionable.',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/pmoscode/toniebox-manager'],
      enabled: false,
    },
    {
      description: 'Minecraft version, Fabric loader and mods are pinned in the environment, the image update only changes the launcher.',
      matchDatasources: ['docker'],
      matchPackageNames: ['itzg/minecraft-server'],
      prBodyNotes: ['`VERSION`, `FABRIC_LOADER_VERSION` and `MODRINTH_PROJECTS` stay unchanged. Deploy, then join once to verify.'],
    },
    {
      description: 'SerMon: release candidates (1.0.0-rc.N) to the next candidate or the release. Docker versioning would only compare tags with the same suffix (rc.1).',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/pmoscode/sermon-server'],
      versioning: 'semver',
      prBodyNotes: [
        'Before merging: read the "Upgrade" section of the release notes, then check the signature and that cosign names the digest of this PR: `cosign verify ghcr.io/pmoscode/sermon-server:<version> --certificate-identity "https://github.com/pmoscode/SerMon/.github/workflows/release.yml@refs/tags/v<version>" --certificate-oidc-issuer https://token.actions.githubusercontent.com | grep -o "sha256:[0-9a-f]*" | sort -u`. Compare `initdb/` and `loki/` with `deploy/compose/` of the tag. After the merge deploy the stack (migrate runs first).',
      ],
    },
    {
      description: 'SerMon: TimescaleDB stays on PostgreSQL 17 (the -pg17 suffix), Loki with the server release.',
      matchDatasources: ['docker'],
      matchPackageNames: ['timescale/timescaledb', 'grafana/loki'],
      prBodyNotes: ['Prefer the versions of SerMon\'s `deploy/compose/compose.yaml`; a different one is untested there.'],
    },
  ],
}
